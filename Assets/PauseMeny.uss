:root {
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-and-crop;
    aspect-ratio: auto;
    align-content: auto;
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 1;
    flex-basis: auto;
    flex-direction: column;
    flex-wrap: wrap;
}

.PauseButton {
    flex-grow: 1;
    position: absolute;
    top: 70%;
    right: -6%;
    justify-content: center;
    transition-property: right;
    transition-duration: 0.1s;
}

.PauseButton:hover {
    flex-grow: 1;
    position: absolute;
    top: 70%;
    right: -4%;
    justify-content: center;
    transition-property: translate;
    transition-duration: 0.1s;
    translate: -34px 0;
}

.LevelButton {
    margin-top: 0;
    margin-right: 37px;
    margin-bottom: 0;
    margin-left: 27px;
    flex-shrink: 1;
    flex-grow: 0;
    padding-top: 43px;
    padding-right: 43px;
    padding-bottom: 43px;
    padding-left: 43px;
    aspect-ratio: 1;
    width: 6%;
}

.textInfo {
    flex-grow: 1;
    background-color: rgb(188, 191, 196);
    height: 100%;
}

.moreInfo {
    flex-grow: initial;
    align-items: flex-start;
    background-color: rgb(51, 51, 51);
    height: 40%;
    width: 100px;
    justify-content: center;
    border-bottom-right-radius: 20px;
}
