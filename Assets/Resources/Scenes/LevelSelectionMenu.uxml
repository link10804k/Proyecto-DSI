    </ui:VisualElement>
    <ui:VisualElement name="top" style="flex-grow: 1; background-color: rgb(51, 51, 51);"/>
    <ui:VisualElement name="Body" style="flex-grow: 1; flex-basis: 80%;">
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:VisualElement name="Levels" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-self: center; height: 80%; width: 70%; flex-shrink: 1; align-items: flex-start; align-content: stretch; justify-content: space-evenly; margin-bottom: 26px; margin-top: 22px;">
            <ui:Image source="project://database/Assets/Resources/Images/SVGs/UnknownLevelButton.svg?fileID=7388822144124034973&amp;guid=f574fc8f7bcedf14d9fad82913803a2b&amp;type=3#UnknownLevelButton" class="LevelButton"/>
