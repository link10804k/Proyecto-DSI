        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;"/>
        <ui:VisualElement name="Arrow" class="PauseButton" style="top: 55%;">
            <ui:Image name="ArrowBackground" source="project://database/Assets/Resources/Images/SVGs/ArrowBackground.svg?fileID=7388822144124034973&amp;guid=4167bb40ac29fd148b84f07b66e91da3&amp;type=3#ArrowBackground"/>
            <ui:Image name="ArrowButton" source="project://database/Assets/Resources/Images/SVGs/ArrowButton.svg?fileID=7388822144124034973&amp;guid=b0559814b24433b4e91cade6f4c5fb91&amp;type=3#ArrowButton" style="position: absolute; top: auto; left: 5%; right: auto;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Info" style="flex-grow: 1; height: 30%; padding-top: 22px; padding-right: 150px; padding-bottom: 22px; padding-left: 150px;">
            <ui:VisualElement style="flex-grow: 1; background-color: rgb(208, 211, 216); border-left-color: rgb(208, 211, 216); border-right-color: rgb(208, 211, 216); border-top-color: rgb(208, 211, 216); border-bottom-color: rgb(208, 211, 216); border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-top-left-radius: 41px; border-top-right-radius: 41px; border-bottom-right-radius: 41px; border-bottom-left-radius: 41px; flex-direction: row; flex-wrap: wrap; flex-shrink: 1; align-content: auto; align-self: auto; justify-content: flex-start; align-items: flex-start;">
                <ui:VisualElement name="Photo" style="flex-grow: 1; width: 20%; height: 100%; background-color: rgb(51, 51, 51); border-top-left-radius: 32px; border-bottom-left-radius: 32px; border-left-color: rgb(51, 51, 51); border-right-color: rgb(51, 51, 51); border-top-color: rgb(51, 51, 51); border-bottom-color: rgb(51, 51, 51); align-self: center;">
                    <ui:VisualElement style="flex-grow: 1; background-color: rgb(255, 0, 206); margin-top: 15px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; width: 150px; height: 100px; align-self: center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="Data" style="flex-grow: 1; width: 80%;">
                    <ui:VisualElement style="flex-grow: 1; align-items: auto; flex-direction: row; width: 100%;">
                        <ui:VisualElement name="InfoDisplay" class="textInfo" style="width: 30%; margin-right: 15px; margin-left: 15px;">
                            <ui:VisualElement name="moreInfo" class="moreInfo"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="InfoDisplay" class="textInfo" style="width: 70%; border-top-right-radius: 32px;">
                            <ui:VisualElement name="moreInfo" class="moreInfo"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: initial; width: auto; height: 15px;"/>
                    <ui:VisualElement style="flex-grow: 1; align-items: auto; flex-direction: row; width: 100%;">
                        <ui:VisualElement name="InfoDisplay" class="textInfo" style="flex-wrap: nowrap; width: 30%; margin-right: 15px; margin-left: 15px;">
                            <ui:VisualElement name="moreInfo" class="moreInfo"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="InfoDisplay" class="textInfo" style="width: 70%; border-bottom-right-radius: 32px;">
                            <ui:VisualElement name="moreInfo" class="moreInfo"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="botttom" style="flex-grow: 1; background-color: rgb(51, 51, 51);"/>
</ui:UXML>
