<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Button.uss?fileID=7433441132597879392&amp;guid=ac202e4748ed6544e8722451b915138b&amp;type=3#Button"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-basis: auto; width: 100%; height: 100%;">
        <ui:VisualElement name="Background" style="position: absolute; width: 100%; height: 100%; aspect-ratio: auto; -unity-background-scale-mode: scale-and-crop; background-image: resource(&quot;Images/SVGs/Subtract&quot;);">
            <ui:Image name="Image" source="project://database/Assets/Resources/Images/SVGs/Rectangle%2038(1).svg?fileID=7388822144124034973&amp;guid=b6addc34204486f4180d92000ad335cf&amp;type=3#Rectangle 38(1)" scale-mode="StretchToFill" style="position: absolute; -unity-background-scale-mode: scale-and-crop;"/>
            <ui:Image source="project://database/Assets/Resources/Images/SVGs/Subtract.svg?fileID=7388822144124034973&amp;guid=08b95ad0ba254be4094cae64092b0d08&amp;type=3#Subtract" scale-mode="StretchToFill" style="position: absolute; -unity-background-scale-mode: scale-and-crop;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Top" style="flex-grow: 1; background-color: rgb(51, 51, 51);"/>
        <ui:VisualElement name="Body" style="flex-grow: 1; height: 85%; align-items: stretch; justify-content: center;">
            <ui:Image name="Start" source="project://database/Assets/Resources/Images/SVGs/PicrossButton.svg?fileID=7388822144124034973&amp;guid=70473b1ed4eb2284499ddfa6456fd66d&amp;type=3#PicrossButton" class="button"/>
            <ui:VisualElement name="steak" style="flex-grow: 1; position: absolute; width: 100%; height: 5%; top: 819px; background-color: rgba(51, 51, 51, 0.66); justify-content: center;">
                <ui:Label text="Play normal Picross in this mode" name="Info" parse-escape-sequences="false" style="font-size: 20px; color: rgb(255, 255, 255); -unity-text-align: middle-center; justify-content: flex-start; -unity-font-definition: resource(&quot;Inter-VariableFont_opsz,wght&quot;); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" style="flex-grow: 1; height: auto; background-color: rgb(51, 51, 51); align-content: flex-start;"/>
    </ui:VisualElement>
</ui:UXML>
