<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Cell" style="flex-grow: 0; border-left-color: rgb(100, 101, 103); border-right-color: rgb(100, 101, 103); border-top-color: rgb(100, 101, 103); border-bottom-color: rgb(100, 101, 103); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; aspect-ratio: auto; flex-shrink: 0; width: 100%; height: 100%; flex-basis: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
        <ui:VisualElement name="Blank" style="background-color: rgb(244, 245, 247); flex-grow: 0; display: flex; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; flex-shrink: 0; width: 100%; height: 100%; flex-basis: auto;"/>
        <ui:VisualElement name="Filled" style="flex-grow: 0; background-color: rgb(51, 51, 51); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; flex-shrink: 0; width: 100%; height: 100%; display: none; flex-basis: auto;"/>
        <ui:VisualElement name="Marked" style="flex-grow: 0; background-color: rgb(244, 245, 247); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; display: none; flex-shrink: 0; width: 100%; height: 100%; flex-basis: auto; align-items: center; justify-content: center; max-height: none; background-image: resource(&quot;Images/SVGs/Cross&quot;); background-size: 60% 60%;"/>
    </ui:VisualElement>
</ui:UXML>
