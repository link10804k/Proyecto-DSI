<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Cell" style="flex-grow: 1; border-left-color: rgb(100, 101, 103); border-right-color: rgb(100, 101, 103); border-top-color: rgb(100, 101, 103); border-bottom-color: rgb(100, 101, 103); border-top-width: 40px; border-right-width: 40px; border-bottom-width: 40px; border-left-width: 40px; border-top-left-radius: 72px; border-top-right-radius: 72px; border-bottom-right-radius: 72px; border-bottom-left-radius: 72px; aspect-ratio: auto; flex-shrink: 1; width: auto; height: auto;">
        <ui:VisualElement name="Blank" style="background-color: rgb(244, 245, 247); flex-grow: 1; display: flex; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px;"/>
        <ui:VisualElement name="Filled" style="flex-grow: 1; background-color: rgb(51, 51, 51); display: none; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px;"/>
        <ui:VisualElement name="Marked" style="flex-grow: 1; background-color: rgb(244, 245, 247); padding-top: 50px; padding-right: 50px; padding-bottom: 50px; padding-left: 50px; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; display: none;">
